// 1. Import niezbędnych narzędzi z frameworka Playwright
import { test, expect } from '@playwright/test';

// 2. test.describe - Grupuje powiązane tematycznie testy (np. wszystkie dotyczące rejestracji)
test.describe('Moduł rejestracji', () => {
    
    // 3. test.beforeEach - Hook (hak). Wykona ten kod automatycznie ZANIM uruchomi każdy pojedynczy test poniżej
    test.beforeEach(async ({ page }) => {
        // Czysty URL, bez nawiasów i udziwnień
        await page.goto('https://app.example.com/register');
    });

    // 4. Pierwszy, na razie pusty test. Przeglądarka ({ page }) jest wstrzykiwana przez Playwrighta
    test('Rejestracja poprawnymi danymi', async ({ page }) => {
    });

    // 5. Drugi test - scenariusz negatywny
    test('Rejestracja z pustym polem email', async ({ page }) => {
        
        // Wypełnienie pola na podstawie tekstu z placeholdera
        await page.getByPlaceholder('Wprowadź hasło').fill('Bezpieczne123!');
        
        // Zapisanie lokatora do stałej (const). Zwróć uwagę na poprawioną ortografię!
        const regulaminCheckbox = page.getByRole('checkbox', { name: 'Akceptuję regulamin' });
        
        // Zaznaczenie checkboxa metodą dedykowaną (.check() zamiast .click())
        await regulaminCheckbox.check();
        
        // Weryfikacja (asercja), czy checkbox na pewno zmienił stan na "zaznaczony"
        await expect(regulaminCheckbox).toBeChecked();
        
        // Zlokalizowanie głównego przycisku 
        const rejestracjaButton = page.getByRole('button', { name: 'Zarejestruj się' });
        
        // Weryfikacja widoczności elementu (dobra, defensywna praktyka)
        await expect(rejestracjaButton).toBeVisible();
        
        // Główna asercja testu - upewnienie się, że brak maila zablokował przycisk wysyłki
        await expect(rejestracjaButton).toBeDisabled();
    });
});
